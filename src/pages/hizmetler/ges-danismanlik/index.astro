---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StructuredData from '../../../components/StructuredData.astro';
import { breadcrumbJsonLd, faqPageJsonLd, serviceJsonLd } from '../../../seo/schema';

const site = Astro.site ?? new URL('https://solutenerji.com');
const path = '/hizmetler/ges-danismanlik/';

const title = 'GES Danışmanlık ve Fizibilite | İzmir, Ege | Solut Enerji';
const description =
  'Güneş enerjisi yatırımı için fizibilite, üretim simülasyonu, teknik denetim ve risk analizi. İzmir ve Ege bölgesinde bağımsız mühendislik danışmanlığı.';

const keywords =
  'ges danışmanlık izmir, güneş enerjisi fizibilite ege, çatı ges teknik danışmanlık, ges yatırım analizi';

const faqs = [
  {
    question: 'Danışmanlık ile anahtar teslim kurulum aynı mı?',
    answer:
      'Danışmanlık; doğru kapasite, ürün kısa listesi, teknik şartname ve süreç risklerinin azaltılmasına odaklanır. Anahtar teslim kurulum ayrı bir sözleşme konusudur; isterseniz iki aşama birlikte planlanabilir.',
  },
  {
    question: 'Fizibilite raporunda neler bulunur?',
    answer:
      'Özetle: saha varsayımları, üretim tahmini aralığı, yatırım maliyeti kalemleri (genel aralık), beklenen tüketim örtüşmesi ve önemli teknik riskler. Abartılı garanti yerine senaryo bazlı okuma sunulur.',
  },
  {
    question: 'Mevcut bir GES kurulumunu denetleyebilir misiniz?',
    answer:
      'Evet; DC tarafı polarite ve izolasyon kontrolleri, AC koruma grubu uyumu, etiketleme ve dokümantasyon gibi başlıklarda saha denetimi ve raporlama yapılabilir.',
  },
  {
    question: 'Hizmet bölgesi İzmir dışına çıkıyor mu?',
    answer:
      'Ege çevresi ve proje ölçeğine göre saha ziyareti planlanır. Uzaktan ön değerlendirme ile başlanıp fizibilite derinliği birlikte netleştirilir.',
  },
] as const;

const breadcrumbItems = [
  { name: 'Ana sayfa', path: '/' },
  { name: 'GES danışmanlık', path },
] as const;

const schemas = [
  breadcrumbJsonLd(site, breadcrumbItems),
  serviceJsonLd(site, {
    name: 'Güneş enerjisi santrali danışmanlığı',
    description,
    path,
  }),
  faqPageJsonLd(faqs),
];
---
<BaseLayout {title} {description} {keywords}>
  <StructuredData slot="head" schema={schemas} />

  <main class="bg-background pb-20 pt-28">
    <article class="mx-auto max-w-3xl px-6">
      <nav aria-label="Sayfa konumu" class="mb-10 text-sm text-on-surface-variant">
        <ol class="flex flex-wrap gap-x-2 gap-y-1">
          <li>
            <a href="/" class="text-secondary underline-offset-4 hover:underline">Ana sayfa</a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="text-on-surface">GES danışmanlık</li>
        </ol>
      </nav>

      <h1 class="font-headline text-3xl font-bold tracking-tight text-primary md:text-4xl">
        İzmir ve Ege’de GES danışmanlığı ve fizibilite
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-on-surface-variant">
        Güneş enerjisi yatırımı; doğru başlangıç gücü, bağlantı koşulları ve ürün seçimiyle belirlenir. Danışmanlık
        hizmetimiz, yatırımcının teknik ve ticari risklerini erken aşamada görünür kılar. İzmir ve Ege bölgesinde saha
        gerçekleriyle uyumlu fizibilite ve teknik şartname hazırlığı sunuyoruz.
      </p>

      <h2 class="mt-12 font-headline text-2xl font-bold text-primary">Kimler için?</h2>
      <p class="mt-4 leading-relaxed text-on-surface-variant">
        Mesken ve ticari çatı sahipleri, site yönetimleri, küçük ölçekli sanayi çatıları ve yatırımcı ortaklıklar;
        kurulum öncesi bağımsız teknik görüş veya ikinci görüş talep ettiğinde bu hizmet devreye girer.
      </p>

      <h2 class="mt-10 font-headline text-2xl font-bold text-primary">Çalışma başlıkları</h2>
      <ul class="mt-4 list-disc space-y-3 ps-5 leading-relaxed text-on-surface-variant">
        <li>Ön fizibilite ve üretim simülasyonu (PVsyst benzeri araçlarla senaryo).</li>
        <li>Teknik şartname ve ihale dosyası desteği (kurulum firmasından bağımsız).</li>
        <li>Kurulum sonrası kabul denetimi ve eksiklik raporu.</li>
        <li>Performans sapması analizi (ölçüm verisi varsa).</li>
      </ul>

      <h2 class="mt-10 font-headline text-2xl font-bold text-primary">Şeffaf karar zemini</h2>
      <p class="mt-4 leading-relaxed text-on-surface-variant">
        Mühendislik kimliğimizle, abartılı üretim veya geri dönüş vaatleri yerine ölçülebilir varsayımlar ve
        duyarlılık analizi paylaşırız. Amaç yatırımcının, hangi senaryoda hangi riskin oluştuğunu görebilmesi ve
        kurulum tekliflerini aynı teknik dille kıyaslayabilmesidir.
      </p>

      <h2 class="mt-10 font-headline text-2xl font-bold text-primary">Rapor çıktıları neleri kapsar?</h2>
      <p class="mt-4 leading-relaxed text-on-surface-variant">
        Proje kapsamına göre saha gözlemi, tüketim profili, olası panel yerleşimi, inverter yaklaşımı, gölgelenme
        notları, üretim tahmini aralığı, kablo ve pano riskleri, izin süreci varsayımları ve bütçe kalemleri tek
        raporda toplanır. Ticari teklif alınacaksa teknik şartname daha net hale getirilir; böylece farklı firmalardan
        gelen teklifler yalnızca fiyat üzerinden değil, ekipman seviyesi ve uygulama standardı üzerinden de
        karşılaştırılabilir.
      </p>

      <h2 class="mt-10 font-headline text-2xl font-bold text-primary">İkinci görüş ve saha denetimi</h2>
      <p class="mt-4 leading-relaxed text-on-surface-variant">
        Mevcut bir teklifin kapasite, ürün, garanti ve geri dönüş varsayımları açısından bağımsız gözle incelenmesi
        çoğu projede ciddi karar avantajı sağlar. Kurulumu devam eden veya tamamlanmış sistemlerde ise etiketleme,
        koruma ekipmanları, kablo güzergâhı, inverter ayarları, dokümantasyon ve üretim verileri kontrol edilerek
        eksiklik listesi hazırlanabilir. Bu çalışma, yükleniciyle daha net konuşulmasına ve kabul sürecinde ölçülebilir
        kriterler kullanılmasına yardımcı olur.
      </p>

      <h2 class="mt-10 font-headline text-2xl font-bold text-primary">İzmir ve Ege yatırım kapsamı</h2>
      <p class="mt-4 leading-relaxed text-on-surface-variant">
        İzmir, Manisa, Aydın, Denizli, Muğla ve çevre illerde çatı tipi, tüketim yapısı ve bağlantı koşulları
        projeden projeye değişir. Bu nedenle ön değerlendirmede tesis faturası, çatı planı veya uydu görüntüsü,
        pano bilgisi ve varsa geçmiş teklif dosyaları istenir. Daha sonra saha ziyareti gerekip gerekmediği, rapor
        derinliği ve teslim takvimi birlikte belirlenir.
      </p>

      <h2 class="mt-10 font-headline text-2xl font-bold text-primary">Yatırımcı için karar matrisi</h2>
      <p class="mt-4 leading-relaxed text-on-surface-variant">
        Bir GES yatırımında en ucuz teklif her zaman en iyi toplam maliyet anlamına gelmez. Panel ve inverter
        verimi, garanti koşulları, servis ağı, konstrüksiyon kalitesi, kablo markası, koruma ekipmanları, izleme
        yazılımı ve yüklenicinin teslim dokümantasyonu aynı tabloda değerlendirilmelidir. Danışmanlık sürecinde
        teklifleri teknik kriterlere ayırarak güçlü ve zayıf noktaları görünür hale getiririz. Böylece yatırımcı,
        hangi farkın gerçekten değer kattığını ve hangi farkın yalnızca kalem azaltma olduğunu daha net görebilir.
      </p>

      <h2 class="mt-10 font-headline text-2xl font-bold text-primary">Performans ve kabul kriterleri</h2>
      <p class="mt-4 leading-relaxed text-on-surface-variant">
        Kurulum sonrası kabulde üretim verisi tek başına yeterli değildir. DC bağlantılar, AC pano düzeni, etiketleme,
        topraklama sürekliliği, inverter hata kayıtları, izleme platformu erişimi, as-built çizimler ve garanti
        belgeleri birlikte kontrol edilmelidir. Performans sapması şüphesinde meteorolojik koşullar, gölgelenme,
        panel kirliliği ve inverter sınırlamaları ayrı ayrı incelenir. Bu yaklaşım, hem yeni kurulumu teslim alırken
        hem de mevcut sistemin beklenenden az üretmesi durumunda daha somut aksiyon alınmasını sağlar.
      </p>

      <h2 class="mt-10 font-headline text-2xl font-bold text-primary">Bağımsız danışmanlık neden önemlidir?</h2>
      <p class="mt-4 leading-relaxed text-on-surface-variant">
        Yüklenici firma doğal olarak kendi ürün ve uygulama yaklaşımını savunur. Bağımsız teknik danışmanlık ise
        yatırımcının yanında durarak kapasite, maliyet, risk ve sözleşme kapsamını daha dengeli değerlendirmeye
        yardımcı olur. Bu çalışma kurulum firmasının yerine geçmez; aksine doğru soruların sorulmasını, teknik şartların
        netleşmesini ve teslim aşamasında beklentilerin ölçülebilir hale gelmesini sağlar. Özellikle ilk kez GES yatırımı
        yapan site, işletme veya bireysel yatırımcılar için bu görünürlük karar stresini belirgin biçimde azaltır.
      </p>

      <p class="mt-6">
        <a
          href="/#iletisim"
          class="inline-flex min-h-[44px] items-center rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-on-primary transition-opacity hover:opacity-90"
        >
          Danışmanlık talebi oluşturun
        </a>
        <a
          href="/#danismanlik"
          class="ms-4 inline-flex min-h-[44px] items-center text-sm font-semibold text-secondary underline-offset-4 hover:underline"
        >
          Ana sayfadaki danışmanlık özetine dön
        </a>
      </p>

      <section class="mt-16 border-t border-slate-200 pt-12" aria-labelledby="sss-dan">
        <h2 id="sss-dan" class="font-headline text-2xl font-bold text-primary">
          Sık sorulan sorular
        </h2>
        <dl class="mt-8 space-y-8">
          {faqs.map((item) => (
            <div>
              <dt class="font-semibold text-on-surface">{item.question}</dt>
              <dd class="mt-2 leading-relaxed text-on-surface-variant">{item.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    </article>
  </main>
</BaseLayout>
