  verifiedUser: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
} as const;

type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
  label?: string;
  strokeWidth?: number;
}

const { name, label, strokeWidth = 2 } = Astro.props;
const className = Astro.props.class ?? '';
const path = icons[name];
---

<svg
  class:list={['inline-block h-[1em] w-[1em] shrink-0 align-middle', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-hidden={label ? undefined : 'true'}
>
  {label ? <title>{label}</title> : null}
  <Fragment set:html={path} />
</svg>
