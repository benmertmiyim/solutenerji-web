  savings:
    '<path d="M19 5c-1.5-1.3-3.5-2-6-2-5 0-9 3.1-9 7.5 0 2.3 1.2 4.2 3 5.5v4h4v-2h3v2h4v-4a7.1 7.1 0 0 0 2-3h2v-4h-2a6.2 6.2 0 0 0-1-2.2V5z"/><path d="M8 10h.01"/><path d="M12 7v5"/>',
