---
interface Props {
  title: string;
  description?: string;
  /** public/ köküne göre yol, örn. /assets/solut-enerji-logo-og.jpg */
  image?: string;
  noindex?: boolean;
  /** Virgülle ayrılmış, kısa ve doğal anahtar kelimeler */
  keywords?: string;
  ogType?: 'website' | 'article';
  canonicalPath?: string | null;
}

const {
  title,
  description = 'Güneş enerjisi ve EV şarj çözümleri.',
  image = '/assets/solut-enerji-logo-og.jpg',
  noindex = false,
  keywords,
  ogType = 'website',
  canonicalPath,
} = Astro.props;

const site = Astro.site ?? new URL('https://solutenerji.com');
const canonicalHref =
  canonicalPath === null ? null : new URL(canonicalPath ?? Astro.url.pathname, site).href;
const ogImageUrl = new URL(image.startsWith('/') ? image : `/${image}`, site).href;
const googleVerify = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const twitterSite = import.meta.env.PUBLIC_TWITTER_SITE?.trim();
---
<title>{title}</title>
<meta name="description" content={description} />
{keywords ? <meta name="keywords" content={keywords} /> : null}
{canonicalHref ? <link rel="canonical" href={canonicalHref} /> : null}
{googleVerify ? <meta name="google-site-verification" content={googleVerify} /> : null}
{noindex ? (
  <meta name="robots" content="noindex,follow" />
) : (
  <meta name="robots" content="index,follow" />
)}
<meta property="og:site_name" content="Solut Enerji" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonicalHref ? <meta property="og:url" content={canonicalHref} /> : null}
<meta property="og:type" content={ogType} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content="tr_TR" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
{twitterSite ? <meta name="twitter:site" content={twitterSite} /> : null}
