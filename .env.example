# --- Cloudflare Workers ---
# Dashboard: Workers & Pages → Worker → Settings → Variables
# Production ve Preview/Branch ortamları için aşağıdaki PUBLIC_* değişkenlerini ekleyin.
# Astro değerleri build sırasında sayfaya gömer; deploy öncesi production değerlerini doğrulayın.
# Önerilen komutlar: Build "npm run build", deploy "npx wrangler deploy".
# Node sürümü repodaki .node-version (22) ile hizalı olmalıdır.

# Canlı site kök URL (sitemap, canonical, Open Graph için zorunlu; production'da https olmalı)
PUBLIC_SITE_URL=https://solutenerji.com

# Formspree form kimliği (yalnızca harf/rakam; https://formspree.io/forms → Integration → form ID)
# Dashboard release gate: allowed domains, spam/rate limits ve hedef e-posta doğrulanmalı.
PUBLIC_FORMSPREE_FORM_ID=xdapkazr

# İsteğe bağlı: iletişim ve sosyal (boşsa site.config.ts içindeki varsayılanlar kullanılır)
PUBLIC_CONTACT_EMAIL=iletisim@solutenerji.com
PUBLIC_CONTACT_PHONE_E164=+905071811616
PUBLIC_CONTACT_PHONE_DISPLAY=+90 (507) 181 16 16
PUBLIC_CONTACT_ADDRESS=Umutbey Mah. Şehitler Cd. No 10C Konak/İzmir
# Schema.org / Google İşletme Profili ile aynı NAP için (boş bırakılabilir)
PUBLIC_STREET_ADDRESS=Umutbey Mah. Şehitler Cd. No 10C
PUBLIC_ADDRESS_LOCALITY=İzmir
PUBLIC_ADDRESS_REGION=İzmir
PUBLIC_ADDRESS_COUNTRY=TR
PUBLIC_OPENING_HOURS=Mo-Sa 09:00-18:00
PUBLIC_OPENING_HOURS_DISPLAY=Pazartesi - Cumartesi: 09:00 - 18:00
PUBLIC_INSTAGRAM_URL=https://www.instagram.com/solutenerji
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/solutenerji

# Google Search Console HTML etiket doğrulaması (meta name="google-site-verification")
# PUBLIC_GOOGLE_SITE_VERIFICATION=

# Twitter/X kartları için @kullanici (isteğe bağlı)
# PUBLIC_TWITTER_SITE=@solutenerji
